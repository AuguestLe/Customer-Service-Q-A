{
  "name": "ai-customer-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup:api": "uv sync --project backend --extra dev",
    "dev": "concurrently --kill-others -n API,WEB -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:mock": "cross-env CHAT_MODE=mock npm run dev",
    "dev:api": "uv run --project backend uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "uv run --project backend --extra dev pytest backend/tests",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:api && npm run lint:api",
    "lint:api": "uv run --project backend --extra dev ruff check backend"
  },
  "dependencies": { "vue": "3.5.44" },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "happy-dom": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}

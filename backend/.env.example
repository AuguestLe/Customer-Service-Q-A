# 复制为 backend/.env，填入真实密钥；不要提交 .env，也不要把密钥交给浏览器。
CHAT_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以你的账号当前可用模型为准；不固定使用历史 V3/R1 别名。
DEEPSEEK_MODEL=deepseek-flash
# 当前接口 none 表示普通非推理模式。使用其他兼容服务时按其能力调整。
DEEPSEEK_REASONING_EFFORT=none
MAX_OUTPUT_TOKENS=2048
UPSTREAM_TIMEOUT_SECONDS=90
# 调试页面而不使用真实模型：npm run dev:mock。界面会明确显示模拟模式。
# 无登录/持久化，仅面向本地开发；不要直接暴露到公网。
